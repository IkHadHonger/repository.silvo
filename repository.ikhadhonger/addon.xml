<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.ikhadhonger"
       name="IkHadHonger Kodi Repository"
       version="1.0.2"
       provider-name="IkHadHonger">

    <extension point="xbmc.addon.repository"
               name="IkHadHonger Kodi Repository">

        <!-- Kodi 22 / Piers -->
        <dir minversion="21.9.1">
            <info compressed="false">https://raw.githubusercontent.com/IkHadHonger/repository.silvo/cube-custom/piers/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/IkHadHonger/repository.silvo/cube-custom/piers/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/IkHadHonger/repository.silvo/cube-custom/piers/</datadir>
        </dir>

        <!-- Kodi 21 / AVDVPlus -->
        <dir minversion="21.0.0" maxversion="21.8.99">
            <info compressed="false">https://raw.githubusercontent.com/IkHadHonger/repository.silvo/cube-custom/avdvplus/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/IkHadHonger/repository.silvo/cube-custom/avdvplus/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/IkHadHonger/repository.silvo/cube-custom/avdvplus/</datadir>
        </dir>

    </extension>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">IkHadHonger Kodi Repository</summary>
        <description lang="en_GB">Kodi repository for custom Aeon Nox: SiLVO builds and related add-ons.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>

</addon>
